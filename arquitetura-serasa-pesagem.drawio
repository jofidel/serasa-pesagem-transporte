        </mxCell>
        <mxCell id="deploy" value="&lt;b&gt;Execução atual:&lt;/b&gt; Docker Compose com app, Kafka e PostgreSQL (ou app local em modo dev conectando aos serviços).  &lt;b&gt;Escala cloud descrita:&lt;/b&gt; app stateless em Kubernetes/ECS, Kafka e PostgreSQL gerenciados, TLS/segredos/observabilidade — recomendações documentadas, não recursos provisionados neste repositório." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;dashed=1;dashPattern=6 4;fontColor=#475569;fontSize=14;spacing=12;" vertex="1" parent="1">
